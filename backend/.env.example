# Copy to backend/.env and start uvicorn with:  uvicorn app.main:app --env-file .env --port 8000
# Every value below is optional; the defaults shown are what the code uses.

# Ollama (local LLM). For better answers try llama3.1:8b or qwen2.5:7b (ollama pull <model> first).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Rasa NLU server (must be started with `rasa run --enable-api` after `rasa train`)
RASA_URL=http://localhost:5005

# Conversation log database (SQLite by default)
DATABASE_URL=sqlite:///./chatbot.db
